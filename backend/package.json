{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "node src/utils/seeder.js",
    "lint": "eslint . --ext .js",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/**/*.test.js",
    "test:admin": "node --test tests/admin/**/*.test.js",
    "test:staff": "node --test tests/staff/**/*.test.js",
    "test:customer": "node --test tests/customer/**/*.test.js",
    "test:combo": "node --test tests/comboTime.test.js",
    "coverage": "c8 node --test tests/**/*.test.js",
    "coverage:combo": "c8 --include=src/controllers/comboController.js --include=src/services/comboTimeService.js --include=src/routes/comboRoutes.js --include=src/models/ComboPackage.js --include=src/models/ComboItem.js --include=src/models/ComboTime.js node --test tests/comboTime.test.js",
    "coverage:pricing": "c8 --include=src/controllers/pricingPlanController.js --include=src/routes/pricingPlanRoutes.js --include=src/services/pricingPlanService.js --include=src/models/PricingPlan.js --include=src/models/ZonePricingPlan.js node --test tests/admin/pricing-plans/**/*.test.js",
    "coverage:transactions": "c8 --include=src/controllers/transactionController.js --include=src/services/transactionService.js --include=src/routes/transactionRoutes.js --include=src/models/FinancialTransaction.js node --test tests/admin/transactions/**/*.test.js",
    "coverage:members": "c8 --include=src/controllers/memberController.js --include=src/routes/memberRoutes.js --include=src/services/memberService.js --include=src/models/Member.js node --test tests/admin/members/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.3",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.4",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14"
  }
}
